<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Set up teams"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Tap a player or checkbox to place them in the next open slot. Drag players onto the court or between slots to swap them."
            android:textColor="#666666"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Players"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggleDeleteModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Players to Delete" />

        <LinearLayout
            android:id="@+id/deleteControlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/selectAllPlayersButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select All" />

            <Button
                android:id="@+id/deleteSelectedPlayersButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delete Selected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/availablePlayersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="COURT"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2E7D32"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#388E3C"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/team1CourtLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="TEAM 1"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/team1Slot1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Drop player here"
                    android:textColor="#222222"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/team1Slot2"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Drop player here"
                    android:textColor="#222222"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#388E3C"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/team2CourtLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="TEAM 2"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/team2Slot1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Drop player here"
                    android:textColor="#222222"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/team2Slot2"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Drop player here"
                    android:textColor="#222222"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clearCourtButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear Court" />

            <Button
                android:id="@+id/swapCourtSidesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Swap Teams" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
